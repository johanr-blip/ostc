<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#050505">
  <title>{{ page_title | escape }}{% unless page_title contains settings.brand_name %} — {{ settings.brand_name | escape }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  {% if settings.concept_mode %}<meta name="robots" content="noindex,nofollow">{% endif %}
  <meta property="og:site_name" content="{{ settings.brand_name | escape }}"><meta property="og:title" content="{{ page_title | escape }}"><meta property="og:url" content="{{ canonical_url }}"><meta property="og:type" content="website">
  {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
  {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
  {{ content_for_header }}
  {{ 'ost.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'ost.js' | asset_url }}" defer></script>
</head>
<body>
  <a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>
  {% sections 'header-group' %}
  <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
</body>
</html>
