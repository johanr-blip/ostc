{% assign person = section.settings.person %}
<section class="section wrap editorial"><div class="editorial-visual">{% if person != blank and person.published.value == true %}{% if person.portrait.value %}{{ person.portrait.value | image_url: width: 1000 | image_tag: loading: 'lazy' }}{% endif %}{% else %}<span class="meta">{{ settings.brand_name | escape }} ARCHIV / IN VORBEREITUNG</span><span class="archive-number">001</span><h3>MENSCHEN.<br>BRÜCHE.<br>BEWEGUNG.</h3><span class="meta">EIN ARCHIV FÜR DAS, WAS BLEIBT.</span>{% endif %}</div><div class="editorial-copy"><p class="eyebrow">02 / {{ settings.brand_name | escape }} ARCHIV</p><h2>{{ section.settings.heading | escape }}</h2>{{ section.settings.copy }}{% if person != blank and person.published.value == true %}<a class="text-link" href="{{ person.system.url }}">{{ person.name.value | escape }} — Geschichte lesen ↗</a>{% else %}<a class="text-link" href="/pages/archiv">Zum Archiv ↗</a>{% endif %}</div></section>

{% schema %}
{
  "name": "Ost Archive Feature",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "HERKUNFT HAT VIELE GESICHTER."
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Text",
      "default": "<p>Menschen, die den Osten geprägt haben. In der Literatur, auf der Bühne, im Labor und im Alltag. Wir erzählen ihre Geschichten mit Raum für Widersprüche.</p>"
    },
    {
      "type": "metaobject",
      "id": "person",
      "label": "Archivperson",
      "metaobject_type": "ost_archive_person"
    }
  ],
  "presets": [
    {
      "name": "Ost Archive Feature"
    }
  ]
}
{% endschema %}
