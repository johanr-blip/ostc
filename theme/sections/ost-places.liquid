<section class="section wrap rule"><div class="section-top"><div><p class="eyebrow">04 / {{ settings.brand_name | escape }} ORTE</p><h2>{{ section.settings.heading | escape }}</h2></div><a class="text-link" href="/pages/orte">Alle Orte ↗</a></div><div class="place-list">{% for block in section.blocks %}<a class="place-item" href="{{ block.settings.link | default: '/pages/orte' }}" {{ block.shopify_attributes }}><h3>{{ block.settings.name | escape }}</h3><span>{{ block.settings.caption | escape }}</span></a>{% endfor %}</div></section>

{% schema %}
{
  "name": "Ost Places",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "WO WIR HERKOMMEN."
    }
  ],
  "blocks": [
    {
      "type": "place",
      "name": "Ort",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Ort",
          "default": "LEIPZIG"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Unterzeile",
          "default": "SACHSEN"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ost Places"
    }
  ]
}
{% endschema %}
