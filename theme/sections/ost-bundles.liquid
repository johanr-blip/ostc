{% if section.blocks.size > 0 %}<section class="wrap section rule"><div class="section-top"><h2>{{ section.settings.heading | escape }}</h2></div><div class="bundle-grid">{% for block in section.blocks %}{% assign bundle = block.settings.product %}{% if bundle != blank %}<article class="bundle-card" {{ block.shopify_attributes }}><h3>{{ bundle.title | escape }}</h3><p>{{ block.settings.copy | escape }}</p><p>{{ bundle.price | money }}</p><a class="text-link" href="{{ bundle.url }}">Bundle ansehen ↗</a></article>{% endif %}{% endfor %}</div></section>{% endif %}

{% schema %}
{
  "name": "Ost Bundles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "ZUSAMMEN GEDACHT."
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Shopify Bundle-Produkt",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Bundle-Produkt"
        },
        {
          "type": "text",
          "id": "copy",
          "label": "Beschreibung"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ost Bundles"
    }
  ]
}
{% endschema %}
