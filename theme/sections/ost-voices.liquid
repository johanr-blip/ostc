<section class="section wrap rule voices"><div><p class="eyebrow">03 / {{ settings.brand_name | escape }} STIMMEN</p><h2>{{ section.settings.heading | escape }}</h2></div><div>{{ section.settings.copy }}<a class="text-link" href="/pages/stimmen">Stimmen kennenlernen ↗</a></div></section>

{% schema %}
{
  "name": "Ost Voices",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "DEIN OSTEN. DEINE GESCHICHTE."
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Text",
      "default": "<p>Geboren in Magdeburg. Angekommen in Köln. Oder nie aus Rostock weggewesen. Herkunft endet nicht an einer Landesgrenze.</p><p>Hier ist Platz für die Menschen hinter den Orten. Die ersten Gespräche folgen.</p>"
    }
  ],
  "presets": [
    {
      "name": "Ost Voices"
    }
  ]
}
{% endschema %}
