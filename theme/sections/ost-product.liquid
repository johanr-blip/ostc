{% assign variant = product.selected_or_first_available_variant %}
{% assign mode = product.metafields.ost.sale_mode.value | default: settings.sale_mode %}
{% if settings.sale_mode == 'waitlist' or settings.commerce_ready == false %}{% assign mode = 'waitlist' %}{% endif %}
<section class="wrap product-detail"><div class="product-gallery">{% for image in product.images %}{% if forloop.first %}{{ image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '400, 700, 1000, 1400', sizes: '(max-width: 600px) 100vw, 55vw', fetchpriority: 'high' }}{% else %}{{ image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1400', sizes: '(max-width: 600px) 100vw, 55vw' }}{% endif %}{% else %}<div class="product-media"><div class="product-empty"><strong>{{ product.title | escape }}</strong><small>PRODUKTBILD FOLGT</small></div></div>{% endfor %}</div>
<div class="product-info"><p class="eyebrow">{{ settings.brand_name | escape }} / DROP {{ product.metafields.ost.drop.value | default: '001' }}</p><h1>{{ product.title | escape }}</h1><p class="price">{{ variant.price | money }}</p><p class="purchase-note">{% if settings.concept_mode %}{{ settings.price_note | escape }}{% else %}{{ 'product.taxes' | t }} <a href="{{ settings.shipping_page.url | default: '/pages/versand' }}">{{ 'product.shipping' | t }}</a>{% endif %}</p>
<div>{{ product.description }}</div>
{% if mode == 'waitlist' %}<div class="product-state"><span class="tag">IN VORBEREITUNG / DROP {{ product.metafields.ost.drop.value | default: '001' }}</span><p>Dieses Teil wird bemustert und für den ersten Drop vorbereitet.</p><a class="button" href="#waitlist">{{ 'product.waitlist' | t }} <span aria-hidden="true">↗</span></a></div>
{% elsif mode == 'sold_out' %}<div class="product-state"><span class="tag">{{ 'product.sold_out' | t }}</span><p>Diese Ausführung ist derzeit nicht verfügbar. Trag dich ein, wenn du beim nächsten Bestand benachrichtigt werden möchtest.</p><a class="button" href="#waitlist">Verfügbarkeit merken <span aria-hidden="true">↗</span></a></div>
{% elsif mode == 'archived' %}<div class="product-state"><span class="tag">{{ 'product.archived' | t }}</span><p>Dieses Teil gehört zu einem abgeschlossenen Drop und ist aktuell nicht mehr erhältlich.</p><a class="text-link" href="{{ routes.all_products_collection_url }}">Aktuellen Drop ansehen ↗</a></div>
{% else %}
 <form action="{{ product.url }}" method="get"><label for="Variant-{{ section.id }}">{{ 'product.variant' | t }}</label><select id="Variant-{{ section.id }}" name="variant" data-variant-select>{% for v in product.variants %}<option value="{{ v.id }}" {% if v.id == variant.id %}selected{% endif %}>{{ v.title | escape }} — {{ v.price | money }}{% unless v.available %} · {{ 'product.sold_out' | t }}{% endunless %}</option>{% endfor %}</select><noscript><button type="submit">Variante wählen</button></noscript></form>
 {% if mode == 'preorder' %}
  {% if settings.preorder_ready and product.metafields.ost.shipping_window.value != blank %}<span class="tag">PREORDER / DROP {{ product.metafields.ost.drop.value | default: '001' }}</span><p><strong>Geplantes Lieferfenster:</strong> {{ product.metafields.ost.shipping_window.value | escape }}</p>{% for block in section.blocks %}{% case block.type %}{% when '@app' %}{% render block %}{% endcase %}{% endfor %}<p class="note">Die Vorbestelloption, der heute fällige Betrag und ein möglicher Restbetrag werden im Kaufmodul und im Checkout ausgewiesen.</p>{% else %}<p>Vorbestellungen sind noch nicht geöffnet.</p><a class="button" href="#waitlist">{{ 'product.waitlist' | t }}</a>{% endif %}
 {% elsif mode == 'live' %}
  {% if product.requires_selling_plan %}{% for block in section.blocks %}{% render block %}{% endfor %}{% else %}{% assign product_form_id = 'ProductForm-' | append: section.id %}{% form 'product', product, id: product_form_id %}<input type="hidden" name="id" value="{{ variant.id }}"><label for="Quantity-{{ section.id }}">{{ 'product.quantity' | t }}</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" step="1"><button class="button" type="submit" {% unless variant.available %}disabled{% endunless %}>{% if variant.available %}{{ 'product.add' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</button>{{ form.errors | default_errors }}{% endform %}{% endif %}
 {% endif %}
{% endif %}
<dl class="specs">{% if product.metafields.ost.material.value != blank %}<div><dt>Material</dt><dd>{{ product.metafields.ost.material.value | escape }}</dd></div>{% endif %}{% if product.metafields.ost.gsm.value != blank %}<div><dt>Stoffgewicht</dt><dd>{{ product.metafields.ost.gsm.value }} g/m²</dd></div>{% endif %}{% if product.metafields.ost.fit.value != blank %}<div><dt>Fit</dt><dd>{{ product.metafields.ost.fit.value | escape }}</dd></div>{% endif %}{% if product.metafields.ost.production_method.value != blank %}<div><dt>Veredelung</dt><dd>{{ product.metafields.ost.production_method.value | escape }}</dd></div>{% endif %}</dl>
{% if product.metafields.ost.size_guide.value != blank %}<details class="faq"><summary>Größenberatung</summary>{{ product.metafields.ost.size_guide | metafield_tag }}</details>{% endif %}
{% if product.metafields.ost.archive_link.value != blank %}<a class="text-link" href="{{ product.metafields.ost.archive_link.value.system.url }}">Die Geschichte dahinter ↗</a>{% endif %}
</div></section>
{% if mode == 'live' and settings.concept_mode == false %}<script type="application/ld+json">{{ product | structured_data }}</script>{% endif %}

{% schema %}
{
  "name": "Ost Product",
  "settings": [],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Ost Product"
    }
  ]
}
{% endschema %}
