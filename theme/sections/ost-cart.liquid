<section class="section wrap"><p class="eyebrow">{{ settings.brand_name | escape }}</p><h1>{{ 'general.cart' | t }}</h1>
{% if cart.item_count == 0 %}<div class="empty-state"><p>{{ 'cart.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.back' | t }}</a></div>{% else %}
{% assign cart_blocked = false %}{% if settings.sale_mode == 'waitlist' or settings.commerce_ready == false %}{% assign cart_blocked = true %}{% endif %}
{% for item in cart.items %}{% assign item_mode = item.product.metafields.ost.sale_mode.value | default: settings.sale_mode %}{% if item_mode == 'waitlist' %}{% assign cart_blocked = true %}{% endif %}{% if item_mode == 'preorder' %}{% unless item.selling_plan_allocation %}{% assign cart_blocked = true %}{% endunless %}{% unless settings.preorder_ready %}{% assign cart_blocked = true %}{% endunless %}{% endif %}{% endfor %}
<form action="{{ routes.cart_url }}" method="post"><div>{% for item in cart.items %}<div class="cart-row">{% if item.image %}{{ item.image | image_url: width: 220 | image_tag: loading: 'lazy' }}{% endif %}<div><h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2><p>{{ item.variant.title | escape }}</p>{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}{% for property in item.properties %}{% assign first_char = property.first | slice: 0 %}{% unless first_char == '_' or property.last == blank %}<p>{{ property.first | escape }}: {{ property.last | escape }}</p>{% endunless %}{% endfor %}<a href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></div><div><label for="Qty-{{ forloop.index }}">Anzahl</label><input id="Qty-{{ forloop.index }}" name="updates[]" type="number" min="0" value="{{ item.quantity }}"></div><span>{{ item.final_line_price | money }}</span></div>{% endfor %}</div><div class="cart-summary"><button name="update" type="submit" class="button outline">{{ 'cart.update' | t }}</button><h2>{{ 'cart.subtotal' | t }}: {{ cart.total_price | money }}</h2>{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }} −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<p>Steuern und Versand werden im Checkout abschließend ausgewiesen.</p>{% if cart_blocked %}<p>Ein Artikel ist noch nicht zum Verkauf freigegeben. Bitte entferne ihn, bevor du zur Kasse gehst.</p>{% else %}<button type="submit" name="checkout" class="button">{{ 'cart.checkout' | t }}</button>{% endif %}</div></form>{% endif %}</section>

{% schema %}
{
  "name": "Ost Cart",
  "settings": [],
  "presets": [
    {
      "name": "Ost Cart"
    }
  ]
}
{% endschema %}
