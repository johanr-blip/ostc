{% capture line %}{% render 'ost-line' %}{% endcapture %}
{% assign featured = section.settings.collection %}{% if featured == blank %}{% if line == 'ostfrau' %}{% assign featured = settings.line_b_collection %}{% else %}{% assign featured = settings.line_a_collection %}{% endif %}{% endif %}
<section id="drop-products" class="section wrap" aria-labelledby="Products-{{ section.id }}">
 <div class="section-top"><div><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2 id="Products-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div><a class="text-link" href="{{ featured.url | default: routes.all_products_collection_url }}">Den Drop ansehen ↗</a></div>
 <div class="product-grid">{% for product in featured.products limit: section.settings.limit %}{% render 'ost-product-card', product: product, index: forloop.index %}{% else %}
 {% if settings.concept_mode %}{% for block in section.blocks %}<a class="product-card" href="/pages/drop-001" {{ block.shopify_attributes }}><div class="product-media">{% if block.settings.image %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% else %}{% assign concept_asset = 'ost-cap.webp' %}{% if forloop.index == 1 %}{% assign concept_asset = 'ostmann-tee.webp' %}{% if line == 'ostfrau' %}{% assign concept_asset = 'ostfrau-tee.webp' %}{% endif %}{% elsif forloop.index == 2 %}{% assign concept_asset = 'ost-hoodie.webp' %}{% endif %}<img src="{{ concept_asset | asset_url }}" alt="KI-generierter Designentwurf: {{ block.settings.title | escape }}" width="1254" height="1254" loading="lazy">{% endif %}<span class="product-number">001 / 0{{ forloop.index }}</span></div><div class="product-caption"><div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.caption | escape }}</p></div><span class="price">{{ block.settings.price | escape }}</span></div></a>{% endfor %}
 {% else %}<p>Der erste Drop wird vorbereitet.</p>{% endif %}{% endfor %}</div>
 {% if settings.concept_mode %}<p class="note">{{ settings.price_note | escape }} Bilder zeigen Designkonzepte; Material und Ausführung werden mit Mustern geprüft.</p>{% endif %}
</section>

{% schema %}
{
  "name": "Ost Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "WENIGER TEILE. MEHR BEDEUTUNG."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "DIE ERSTEN DREI."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Anzahl Produkte",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "concept",
      "name": "Konzeptprodukt",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Heavy Tee"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Unterzeile",
          "default": "Schwarz / Weiß"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Planpreis",
          "default": "39,90 €"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Konzeptbild"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ost Product Grid"
    }
  ]
}
{% endschema %}
