{% doc %}
@param {product} product - Product to display.
@param {number} [index] - Display position.
{% enddoc %}
<a class="product-card" href="{{ product.url }}">
 <div class="product-media">
 {% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(max-width: 600px) 50vw, 33vw' }}{% else %}<div class="product-empty"><strong>{{ product.title | escape }}</strong><small>PRODUKTBILD FOLGT</small></div>{% endif %}
 <span class="product-number">{{ product.metafields.ost.drop.value | default: '001' }} / {{ index | default: '01' }}</span>
 </div>
 <div class="product-caption"><div><h3>{{ product.title | escape }}</h3><p>{{ product.metafields.ost.fit.value | default: 'Schwarz / Weiß' | escape }}</p></div><span class="price">{{ product.price | money }}</span></div>
</a>
